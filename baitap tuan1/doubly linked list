#include <iostream>
using namespace std;

// Cấu trúc một Node trong danh sách liên kết kép
struct Node {
    int data;
    Node* next; // Con trỏ trỏ đến Node phía sau
    Node* prev; // Con trỏ trỏ đến Node phía trước
};

// Cấu trúc quản lý List ở bên ngoài
struct List {
    Node* head;
    Node* tail;

    // Khởi tạo danh sách rỗng
    void init() {
        head = nullptr;
        tail = nullptr;
    }

    // Hàm phụ trợ tạo một Node mới độc lập
    Node* createNode(int val) {
        Node* newNode = new Node();
        newNode->data = val;
        newNode->next = nullptr;
        newNode->prev = nullptr;
        return newNode;
    }

    // 1. Trả về phần tử tại vị trí i (bắt đầu từ 0)
    int getAt(int i) {
        if (i < 0 || head == nullptr) {
            cout << "Loi: Vi tri khong hop le hoac danh sach rong!\n";
            return -1;
        }
        Node* temp = head;
        int count = 0;
        while (temp != nullptr) {
            if (count == i) return temp->data;
            count++;
            temp = temp->next;
        }
        cout << "Loi: Vi tri vuot qua kich thuoc danh sach!\n";
        return -1;
    }

    // 2. Thêm vào đầu danh sách
    void insertHead(int val) {
        Node* newNode = createNode(val);
        if (head == nullptr) { // Danh sách đang rỗng
            head = tail = newNode;
            return;
        }
        newNode->next = head;
        head->prev = newNode; // Node cũ trỏ ngược về Node mới
        head = newNode;       // Cập nhật lại head
    }

    // 3. Thêm vào cuối danh sách
    void insertTail(int val) {
        Node* newNode = createNode(val);
        if (head == nullptr) { // Danh sách đang rỗng
            head = tail = newNode;
            return;
        }
        tail->next = newNode;
        newNode->prev = tail; // Node mới trỏ ngược về Node cũ
        tail = newNode;       // Cập nhật lại tail
    }

    // 4. Thêm tại vị trí i
   void insertAt(int i, int val) {
    if (i < 0) {
        cout << "Vi tri them khong hop le!\n";
        return;
    }
    if (i == 0) {
        insertHead(val);
        return;
    }

    Node* temp = head;
    int j = 0;
    
    // Tìm node ở vị trí i
    for (; temp != nullptr && j < i; j++) {
        temp = temp->next;
    }

    // TH1: i lớn hơn số lượng phần tử hiện tại của danh sách
    if (temp == nullptr && j < i) {
        cout << "Vi tri them vuot qua do dai danh sach!\n";
        return;
    }

    // TH2: i bằng đúng số lượng phần tử (chèn vào cuối danh sách)
    if (temp == nullptr && j == i) {
        insertTail(val);
        return;
    }

    // TH3: Chèn vào giữa temp->prev và temp
    Node* newNode = createNode(val);
    Node* previousNode = temp->prev;
    
    newNode->next = temp;
    newNode->prev = previousNode;
    previousNode->next = newNode;
    temp->prev = newNode;
}


    // 5. Xóa đầu danh sách
    void deleteHead() {
        if (head == nullptr) {
            cout << "Danh sach rong, khong the xoa!\n";
            return;
        }
        Node* temp = head;
        head = head->next;
        if (head != nullptr) {
            head->prev = nullptr; // Node đầu mới không còn node đứng trước
        } else {
            tail = nullptr; // Nếu xóa xong danh sách rỗng
        }
        delete temp;
    }

    // 6. Xóa cuối danh sách (Thao tác cực nhanh O(1) nhờ có con trỏ kép)
    void deleteTail() {
        if (tail == nullptr) {
            cout << "Danh sach rong, khong the xoa!\n";
            return;
        }
        Node* temp = tail;
        tail = tail->prev;
        if (tail != nullptr) {
            tail->next = nullptr; // Node cuối mới không còn node đứng sau
        } else {
            head = nullptr; // Nếu xóa xong danh sách rỗng
        }
        delete temp;
    }

    // 7. Xóa tại vị trí i
    void deleteAt(int i) {
        if (i < 0 || head == nullptr) {
            cout << "Vi tri xoa khong hop le hoac danh sach rong!\n";
            return;
        }
        if (i == 0) {
            deleteHead();
            return;
        }
        Node* temp = head;
        // Duyệt tìm node tại đúng vị trí i cần xóa
        for (int j = 0; temp != nullptr && j < i; j++) {
            temp = temp->next;
        }
        if (temp == nullptr) {
            cout << "Vi tri xoa vuot qua kich thuoc danh sach!\n";
            return;
        }
        if (temp == tail) {
            deleteTail();
            return;
        }

        // Tách node temp ra khỏi liên kết
        temp->prev->next = temp->next;
        temp->next->prev = temp->prev;
        delete temp;
    }

    // 8. Duyệt xuôi từ đầu đến cuối
    void traverseForward() {
        cout << "Duyet xuoi: ";
        Node* temp = head;
        while (temp != nullptr) {
            cout << temp->data << " ";
            temp = temp->next;
        }
        cout << "\n";
    }

    // 9. Duyệt ngược từ cuối về đầu (Đi lùi trực tiếp bằng con trỏ prev, không đệ quy)
    void traverseBackward() {
        cout << "Duyet nguoc: ";
        Node* temp = tail;
        while (temp != nullptr) {
            cout << temp->data << " ";
            temp = temp->prev; // Đi lùi về phía trước
        }
        cout << "\n";
    }

    // Hàm giải phóng bộ nhớ danh sách
    void clear() {
        while (head != nullptr) {
            deleteHead();
        }
    }
};

int main() {
    List myList;
    myList.init();

    // Thử nghiệm thêm phần tử
    myList.insertTail(10);
    myList.insertTail(20);
    myList.insertHead(5);
    myList.insertAt(1, 15); // Danh sách: 5 <=> 15 <=> 10 <=> 20

    myList.traverseForward();  // Kết quả: 5 15 10 20
    myList.traverseBackward(); // Kết quả: 20 10 15 5 (In ngược trực tiếp)

    cout << "Phan tu tai vi tri 2: " << myList.getAt(2) << "\n"; // Kết quả: 10

    // Thử nghiệm xóa phần tử
    myList.deleteHead(); // Xóa 5
    myList.deleteTail(); // Xóa 20 (Chạy cực nhanh nhờ con trỏ tail và prev)
    myList.deleteAt(1);  // Xóa phần tử vị trí số 1 hiện tại (số 10)

    myList.traverseForward(); // Kết quả còn lại: 15

    myList.clear(); // Dọn dẹp bộ nhớ trước khi thoát
    return 0;
}
