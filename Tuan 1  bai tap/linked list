#include <iostream>
using namespace std;

// Cấu trúc một Node bên trong danh sách
struct Node {
    int data;
    Node* next;
};

// Cấu trúc quản lý List ở bên ngoài (Chỉ dùng duy nhất con trỏ head)
struct List {
    Node* head;

    // Khởi tạo danh sách rỗng
    void init() {
        head = nullptr;
    }

    // Hàm phụ trợ tạo một Node mới
    Node* createNode(int val) {
        Node* newNode = new Node();
        newNode->data = val;
        newNode->next = nullptr;
        return newNode;
    }

    // 1. Trả về phần tử tại vị trí i
    int getAt(int i) {
        if (i < 0 || head == nullptr) {
            cout << "Loi: Vi tri khong hop le hoac danh sach rong!\n";
            return -1;
        }
        Node* temp = head;
        int count = 0;
        while (temp != nullptr) {
            if (count == i) return temp->data;
            count++;
            temp = temp->next;
        }
        cout << "Loi: Vi tri vuot qua kich thuoc danh sach!\n";
        return -1;
    }

    // 2. Thêm vào đầu danh sách
    void insertHead(int val) {
        Node* newNode = createNode(val);
        newNode->next = head;
        head = newNode;
    }

    // 3. Thêm vào cuối danh sách (Duyệt từ head đến cuối)
    void insertTail(int val) {
        Node* newNode = createNode(val);
        if (head == nullptr) {
            head = newNode;
            return;
        }
        Node* temp = head;
        while (temp->next != nullptr) {
            temp = temp->next; // Tìm node cuối cùng
        }
        temp->next = newNode;
    }

    // 4. Thêm tại vị trí i
    void insertAt(int i, int val) {
        if (i < 0) {
            cout << "Vi tri them khong hop le!\n";
            return;
        }
        if (i == 0) {
            insertHead(val);
            return;
        }
        Node* temp = head;
        // Tìm node đứng ngay trước vị trí i
        for (int j = 0; temp != nullptr && j < i - 1; j++) {
            temp = temp->next;
        }
        if (temp == nullptr) {
            cout << "Vi tri them vuot qua kich thuoc danh sach!\n";
            return;
        }
        Node* newNode = createNode(val);
        newNode->next = temp->next;
        temp->next = newNode;
    }

    // 5. Xóa đầu danh sách
    void deleteHead() {
        if (head == nullptr) {
            cout << "Danh sach rong, khong the xoa!\n";
            return;
        }
        Node* temp = head;
        head = head->next;
        delete temp;
    }

    // 6. Xóa cuối danh sách
    void deleteTail() {
        if (head == nullptr) {
            cout << "Danh sach rong, khong the xoa!\n";
            return;
        }
        if (head->next == nullptr) {
            delete head;
            head = nullptr;
            return;
        }
        Node* temp = head;
        // Dừng lại ở node kế cuối
        while (temp->next->next != nullptr) {
            temp = temp->next;
        }
        delete temp->next; // Xóa node cuối
        temp->next = nullptr;
    }

    // 7. Xóa tại vị trí i
    void deleteAt(int i) {
        if (i < 0 || head == nullptr) {
            cout << "Vi tri xoa khong hop le hoac danh sach rong!\n";
            return;
        }
        if (i == 0) {
            deleteHead();
            return;
        }
        Node* temp = head;
        // Tìm node đứng ngay trước vị trí i cần xóa
        for (int j = 0; temp->next != nullptr && j < i - 1; j++) {
            temp = temp->next;
        }
        if (temp->next == nullptr) {
            cout << "Vi tri xoa vuot qua kich thuoc danh sach!\n";
            return;
        }
        Node* nodeToDelete = temp->next;
        temp->next = nodeToDelete->next;
        delete nodeToDelete;
    }

    // 8. Duyệt xuôi từ đầu đến cuối
    void traverseForward() {
        cout << "Duyet xuoi: ";
        Node* temp = head;
        while (temp != nullptr) {
            cout << temp->data << " ";
            temp = temp->next;
        }
        cout << "\n";
    }

    // 9. Duyệt ngược bằng đệ quy (Không cần quay ngược con trỏ)
    void printBackward(Node* node) {
        if (node == nullptr) return;
        printBackward(node->next); // Gọi đệ quy cho node tiếp theo trước
        cout << node->data << " "; // In dữ liệu sau khi quay lui
    }

    void traverseBackward() {
        cout << "Duyet nguoc: ";
        printBackward(head);
        cout << "\n";
    }

    // Hàm giải phóng toàn bộ danh sách khi chạy xong
    void clear() {
        while (head != nullptr) {
            deleteHead();
        }
    }
};

int main() {
    List myList;
    myList.init();

    // Thử nghiệm các hàm
    myList.insertTail(10);
    myList.insertTail(20);
    myList.insertHead(5);
    myList.insertAt(1, 15); // Danh sách: 5 -> 15 -> 10 -> 20

    myList.traverseForward();  // Kết quả: 5 15 10 20
    myList.traverseBackward(); // Kết quả: 20 10 15 5

    cout << "Phan tu tai vi tri 2: " << myList.getAt(2) << "\n"; // Kết quả: 10

    myList.deleteHead(); // Xóa 5
    myList.deleteTail(); // Xóa 20
    myList.deleteAt(1);  // Xóa 10

    myList.traverseForward(); // Kết quả còn lại: 15

    myList.clear(); // Dọn dẹp bộ nhớ
    return 0;
}
